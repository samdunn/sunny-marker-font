languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem goth dflt;

@TopMarks = [gravecomb acutecomb circumflexcomb tildecomb macroncomb brevecomb dotaccentcomb dieresiscomb ringcomb hungarumlautcomb caroncomb];
@CaseMarks = [gravecomb.case acutecomb.case circumflexcomb.case tildecomb.case macroncomb.case brevecomb.case dotaccentcomb.case dieresiscomb.case ringcomb.case hungarumlautcomb.case caroncomb.case];
@Uppercase = [A AE Aacute Abreve Acircumflex Adieresis Agrave Amacron Aogonek Aring Atilde B C Cacute Ccaron Ccedilla Cdotaccent D Dcaron Dcroat E Eacute Ecaron Ecircumflex Edieresis Edotaccent Egrave Emacron Eogonek Eth F G Gbreve Gcommaaccent Gdotaccent Germandbls H Hbar I Iacute Icircumflex Idieresis Idotaccent Igrave Imacron Iogonek J Jacute K Kcommaaccent L Lacute Lcaron Lcommaaccent Lslash M N Nacute Ncaron Ncommaaccent Ntilde O OE Oacute Ocircumflex Odieresis Ograve Ohungarumlaut Oslash Otilde P Q R Racute Rcaron S Sacute Scaron Scedilla Scommaaccent T Tcaron Tcommaaccent Thorn U Uacute Ucircumflex Udieresis Ugrave Uhungarumlaut Umacron Uogonek Uring V W Wacute Wcircumflex Wdieresis Wgrave X Y Yacute Ycircumflex Ydieresis Ygrave Z Zacute Zcaron Zdotaccent b d dcaron f h k kcommaaccent l lacute lcaron lcommaaccent t tcaron tcommaaccent Eng Omacron Ebreve Ibreve Obreve Ubreve Etilde Itilde Utilde Ucaron Acaron Gcaron Kcaron kcaron Hcaron hcaron Scircumflex Rcommaaccent Tcedilla tcedilla];
feature ccmp {
  sub j acutecomb by jacute;
  sub J acutecomb by Jacute;
  lookup soft_dotted {
    lookupflag UseMarkFilteringSet @TopMarks;
    sub [i j iogonek]' @TopMarks by [dotlessi dotlessj iogonek.dotless];
  } soft_dotted;
  sub [L d l t] caroncomb' by caroncomb.alt;
  sub g commaaccentcomb' by commaaccentcomb.turn;
  lookup case_marks {
    lookupflag UseMarkFilteringSet @TopMarks;
    sub @Uppercase @TopMarks' by @CaseMarks;
  } case_marks;
} ccmp;
feature salt { sub \I by \I.ss01; } salt;
feature ss01 { featureNames { name "Barred capital I"; }; sub \I by \I.ss01; } ss01;
feature aalt { feature salt; } aalt;
