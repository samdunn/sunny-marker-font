diff --git a/tests/test_latin_american_marks.py b/tests/test_latin_american_marks.py
new file mode 100644
index 00000000..4b58fef8
--- /dev/null
+++ b/tests/test_latin_american_marks.py
@@ -0,0 +1,11 @@
+from gfsubsets import CodepointsInSubset
+
+
+def test_macron_below_survives_latin_subsetting():
+    for subset in ("latin", "latin-ext"):
+        assert 0x0331 in CodepointsInSubset(subset)
+
+
+def test_e_tilde_is_shared_with_vietnamese():
+    for subset in ("latin-ext", "vietnamese"):
+        assert {0x1EBC, 0x1EBD} <= CodepointsInSubset(subset)
