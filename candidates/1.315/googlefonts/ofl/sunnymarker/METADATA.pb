fonts {
  name: "Sunny Marker"
  style: "normal"
  weight: 400
  filename: "SunnyMarker[opsz,wdth,wght].ttf"
  post_script_name: "SunnyMarker-Regular"
  full_name: "Sunny Marker Regular"
  copyright: "Copyright 2026 The Sunny Marker Project Authors (https://github.com/samdunn/sunny-marker-font)"
}
fonts {
  name: "Sunny Marker"
  style: "italic"
  weight: 400
  filename: "SunnyMarker-Italic[opsz,wdth,wght].ttf"
  post_script_name: "SunnyMarker-Italic"
  full_name: "Sunny Marker Italic"
  copyright: "Copyright 2026 The Sunny Marker Project Authors (https://github.com/samdunn/sunny-marker-font)"
}
subsets: "latin"
subsets: "latin-ext"
subsets: "menu"
axes {
  tag: "opsz"
  min_value: 10.0
  max_value: 36.0
}
axes {
  tag: "wdth"
  min_value: 75.0
  max_value: 125.0
}
axes {
  tag: "wght"
  min_value: 300.0
  max_value: 700.0
}
source {
